<article class="card">
  <h3><%= project.name %></h3>
  <p><%= project.description %></p>
  <ul class="tags">
    <% project.tech.forEach(function (t) { %><li><%= t %></li><% }) %>
  </ul>
  <div class="card-links">
    <a href="<%= project.repo %>" target="_blank" rel="noopener">Code</a>
    <% if (project.live) { %><a href="<%= project.live %>" target="_blank" rel="noopener">Live site</a><% } %>
  </div>
</article>
